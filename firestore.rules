rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'updatedAt', 'lastSeenAt']);
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt', 'lastSeenAt']);
      allow delete: if false;

      match /creator_vault/{documentId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['type', 'title', 'prompt', 'output', 'metadata', 'createdAt', 'updatedAt'])
          && request.resource.data.type is string
          && request.resource.data.type.size() <= 40
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 180
          && request.resource.data.prompt is string
          && request.resource.data.prompt.size() <= 8000
          && request.resource.data.output is string
          && request.resource.data.output.size() <= 30000;
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'prompt', 'output', 'metadata', 'updatedAt']);
      }
    }

    // No public admin collections. Admin data is returned only from a callable
    // function that verifies the Firebase custom claim server-side.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
